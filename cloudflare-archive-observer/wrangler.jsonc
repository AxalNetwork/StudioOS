{
  // D5676 candidate only. Owner must approve/provision isolated metadata DB, head-only archive access and per-role secrets before enabling.
  "name": "studioos-archive-observer-disabled",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "workers_dev": false,
  "vars": { "ARCHIVE_OBSERVER_ENABLED": "off" },
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } }
}
