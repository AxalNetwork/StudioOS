      } },
      "expect": { "output": "brief", "must_include": ["41,000 USD"], "must_say_not_recorded": ["Churned sites"], "must_not_include": [] },
      "outputs": {
        "correct": "- Active sites: 120\n- Churned sites: Not recorded\n- Revenue in 2026-10: 41,000 USD",
        "incorrect": [
          { "targets": "41,000 USD", "edit": [["41,000 USD", "40,000 USD"]] },
          { "targets": "Churned sites", "edit": [["- Churned sites: Not recorded\n", ""]] }
        ]
      }
    }
  ]
