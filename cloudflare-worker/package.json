{
  "name": "studioos-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.toml",
    "deploy": "cd .. && npm run deploy",
    "db:create": "wrangler d1 create studioos-db",
    "db:schema": "wrangler d1 execute studioos-db --config ../wrangler.toml --file=sql/schema_baseline.sql",
    "db:schema:remote": "wrangler d1 execute studioos-db --config ../wrangler.toml --remote --file=sql/schema_baseline.sql",
    "lint:no-console": "node scripts/check-console.mjs",
    "lint": "npm run lint:no-console && tsc --noEmit"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1",
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.13.11",
    "jose": "^6.2.12",
    "mimetext": "^3.0.28",
    "otpauth": "^9.5.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/qrcode": "^1.5.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.143.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.29.1"
  }
}
