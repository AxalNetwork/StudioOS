{
  "name": "studioos-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../wrangler.toml",
    "deploy": "wrangler deploy --config ../wrangler.toml",
    "db:create": "wrangler d1 create studioos-db",
    "db:schema": "wrangler d1 execute studioos-db --config ../wrangler.toml --file=sql/schema.sql",
    "db:schema:remote": "wrangler d1 execute studioos-db --config ../wrangler.toml --remote --file=sql/schema.sql",
    "lint:no-console": "node scripts/check-console.mjs",
    "lint": "npm run lint:no-console && tsc --noEmit"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.1",
    "hono": "^4.12.30",
    "jose": "^6.2.3",
    "mimetext": "^3.0.28",
    "otpauth": "^9.5.1",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260713.1",
    "@types/qrcode": "^1.5.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.110.0"
  }
}
