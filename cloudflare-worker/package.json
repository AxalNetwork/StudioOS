{
  "name": "studioos-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node ../scripts/build-generated.mjs",
    "dev": "wrangler dev --config ../wrangler.toml",
    "deploy": "cd .. && npm run deploy",
    "db:create": "wrangler d1 create studioos-db",
    "db:schema": "wrangler d1 execute studioos-db --config ../wrangler.toml --file=sql/schema_baseline.sql",
    "db:schema:remote": "wrangler d1 execute studioos-db --config ../wrangler.toml --remote --file=sql/schema_baseline.sql",
    "lint:no-console": "node scripts/check-console.mjs",
    "prelint": "node ../scripts/build-generated.mjs",
    "lint": "npm run lint:no-console && tsc --noEmit"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.4",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@simplewebauthn/server": "^14.0.3",
    "agents": "0.32.0",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "libphonenumber-js": "1.13.15",
    "mimetext": "^3.0.28",
    "otpauth": "^9.5.2",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "twitter-text": "3.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@types/qrcode": "^1.5.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.1"
  },
  "overrides": {
    "sharp": "0.35.5",
    "undici": "7.30.1"
  }
}
