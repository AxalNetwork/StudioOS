{
  "$id": "deckGrid",
  "title": "GET /api/decks/:id/grid (D1499, #3749)",
  "description": "The reply the deck v2 adapter's `grid` method passes through. D1511 (#3762).",
  "type": "object",
  "additionalProperties": false,
  "required": ["deck_id", "version", "aspect", "lang", "dir", "script", "slide", "frame", "cell", "baseline", "grid", "structures", "cards"],
  "properties": {
    "deck_id": { "type": "integer", "minimum": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "aspect": { "enum": ["16:9", "4:3"] },
    "lang": { "description": "D1571 (#3818): the deck's language (theme.lang, a BCP 47 tag), or null when none was chosen. No `type`, so null holds." },
    "dir": { "enum": ["ltr", "rtl"], "description": "D1571: the direction the deck's words read in." },
    "script": { "enum": ["latin", "arabic", "hebrew", "cjk"], "description": "D1571: the script its capacity is measured in (designSystem.SCRIPT_EM)." },
    "slide": { "$ref": "#/$defs/size" },
    "frame": {
      "type": "object", "additionalProperties": false,
      "required": ["marginX", "marginTop", "marginBottom", "gutter"],
      "properties": {
        "marginX": { "type": "number", "minimum": 0 },
        "marginTop": { "type": "number", "minimum": 0 },
        "marginBottom": { "type": "number", "minimum": 0 },
        "gutter": { "type": "number", "minimum": 0 }
      }
    },
    "cell": { "$ref": "#/$defs/size" },
    "baseline": { "const": 8 },
    "grid": {
      "type": "object", "additionalProperties": false, "required": ["cols", "rows"],
      "properties": { "cols": { "const": 12 }, "rows": { "const": 6 } }
    },
    "structures": {
      "type": "array", "minItems": 17, "maxItems": 17,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "label", "use", "areas"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "use": { "type": "string" },
          "background": { "enum": ["image"] },
          "recommended": { "type": "array", "items": { "type": "string" } },
          "areas": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/area" } }
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["index", "structure", "derived", "areas"],
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "structure": { "type": "string" },
          "derived": { "type": "boolean" },
          "areas": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/area" } }
        }
      }
    }
  },
  "$defs": {
    "size": {
      "type": "object", "additionalProperties": false, "required": ["width", "height"],
      "properties": { "width": { "type": "number", "minimum": 0 }, "height": { "type": "number", "minimum": 0 } }
    },
    "area": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "c1", "c2", "r1", "r2", "order", "inset", "align", "box"],
      "properties": {
        "id": { "type": "string" },
        "c1": { "type": "integer", "minimum": 1, "maximum": 12 },
        "c2": { "type": "integer", "minimum": 1, "maximum": 12 },
        "r1": { "type": "integer", "minimum": 1, "maximum": 6 },
        "r2": { "type": "integer", "minimum": 1, "maximum": 6 },
        "order": { "type": "integer", "minimum": 1 },
        "inset": { "type": "integer", "minimum": 0, "maximum": 4 },
        "align": { "enum": ["start", "center", "end"] },
        "role": { "type": "string" },
        "box": {
          "type": "object", "additionalProperties": false, "required": ["x", "y", "w", "h"],
          "properties": {
            "x": { "type": "integer", "minimum": 0 }, "y": { "type": "integer", "minimum": 0 },
            "w": { "type": "integer", "minimum": 1 }, "h": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
