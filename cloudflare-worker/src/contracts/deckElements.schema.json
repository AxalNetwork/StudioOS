{
  "$id": "deckElements",
  "title": "GET /api/decks/elements (D1541, #3779)",
  "description": "The elements library the deck v2 adapter's `elementsLibrary` method passes on (with a page of `GET /api/decks/elements/icons`): the icon set's licence record, the decor cap, the shapes, dividers and textures with their sanitised SVG, and Generate, which is Coming later. D1511 (#3762).",
  "type": "object",
  "additionalProperties": false,
  "required": ["licence", "decor_max", "icons", "shapes", "dividers", "textures", "generate"],
  "properties": {
    "licence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "version", "spdx", "url", "copyright", "derived"],
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" }, "version": { "type": "string" },
        "spdx": { "enum": ["MIT", "ISC", "Apache-2.0", "OFL-1.1"] }, "url": { "type": "string" },
        "copyright": { "type": "string" }, "derived": { "type": "string" }
      }
    },
    "decor_max": { "const": 16 },
    "icons": { "type": "object", "additionalProperties": false, "required": ["total"], "properties": { "total": { "type": "integer", "minimum": 1000 } } },
    "shapes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } },
    "dividers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } },
    "textures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } },
    "generate": {
      "type": "object", "additionalProperties": false, "required": ["available", "reason"],
      "properties": { "available": { "const": false }, "reason": { "type": "string" } }
    }
  },
  "$defs": {
    "item": {
      "type": "object", "additionalProperties": false, "required": ["kind", "ref", "label", "svg"],
      "properties": {
        "kind": { "enum": ["shape", "divider", "texture"] }, "ref": { "type": "string" },
        "label": { "type": "string" }, "svg": { "type": "string" }
      }
    }
  }
}
