{
  "$id": "deckTypedTables",
  "title": "GET /api/decks/:id/typed-values (D1538, #3787)",
  "description": "The reply the deck v2 adapter's `typedTables` method passes through: the deck and the venture's typed figures, graded Stated, at most 200 (`routes/deck_typed_values.ts`, `TYPED_MAX`). A key nobody typed is absent, never 0. `value` is a number, or a string when the unit is text; `typed_by` is the person or null. D1511 (#3762).",
  "type": "object",
  "additionalProperties": false,
  "required": ["deck_id", "values"],
  "properties": {
    "deck_id": { "type": "integer", "minimum": 1 },
    "values": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["key", "label", "value", "unit", "grade", "typed_by", "typed_at"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "value": {},
          "unit": { "enum": ["count", "usd", "percent", "months", "text"] },
          "grade": { "const": "Stated" },
          "typed_by": {
            "additionalProperties": false, "required": ["id", "name"],
            "properties": { "id": { "type": "integer", "minimum": 1 }, "name": {} }
          },
          "typed_at": { "type": "string" }
        }
      }
    }
  }
}
