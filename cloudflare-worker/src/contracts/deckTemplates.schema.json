{
  "$id": "deckTemplates",
  "title": "GET /api/decks/templates (D1535, #3782)",
  "description": "The Gallery's HQ templates the deck v2 adapter's `templates` method passes on, filtered by stage, New deck's seven audiences and style, with the filter options. D1511 (#3762).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "templates",
    "filters"
  ],
  "properties": {
    "templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/meta"
      }
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stages",
        "audiences",
        "styles"
      ],
      "properties": {
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "audiences": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "styles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      }
    }
  },
  "$defs": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uid",
        "name",
        "description",
        "stage",
        "audience_tags",
        "deck_audience",
        "style",
        "swatch",
        "card_count"
      ],
      "properties": {
        "uid": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "description": "text, or null"
        },
        "stage": {
          "description": "pre_seed | seed | series_a | series_b_plus, or null for a member's own"
        },
        "audience_tags": {
          "type": "array",
          "items": {
            "enum": [
              "angel",
              "pre_seed_fund",
              "seed_fund",
              "series_a_fund",
              "strategic",
              "grant",
              "other"
            ]
          }
        },
        "deck_audience": {
          "description": "one of the seven, or null"
        },
        "style": {
          "description": "editorial | bold | minimal, or null"
        },
        "swatch": {
          "description": "one of the eight, or null"
        },
        "card_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    }
  }
}
