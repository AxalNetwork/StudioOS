{
  "$id": "deckReplaceImages",
  "title": "POST /api/decks/:id/images/replace-all/quote (D1561, #3808)",
  "description": "What the deck v2 adapter's `replaceImages` method passes through: Replace all images' one quote (`routes/deck_images.ts`). Either `ai: true` with every image area priced, the figure for the deck, the hold that covers one redraw per area, the areas left out and why, and whether the balance covers it; or `ai: false` with the reason and the words to show. Nothing is run or held by a quote. D1511 (#3762).",
  "type": "object",
  "additionalProperties": false,
  "required": ["ai"],
  "properties": {
    "ai": { "type": "boolean" },
    "count": { "type": "integer", "minimum": 0 },
    "total_microusd": { "type": "integer", "minimum": 0 },
    "hold_microusd": { "type": "integer", "minimum": 0 },
    "areas": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["card", "block", "area", "aspect", "model", "per_image_microusd"],
        "properties": {
          "card": { "type": "integer", "minimum": 0 },
          "block": { "type": "string" },
          "area": { "type": ["string", "null"] },
          "aspect": { "enum": ["16:9", "4:3", "1:1", "3:4"] },
          "model": { "type": "string" },
          "per_image_microusd": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "left_out": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["card", "block", "code", "message"],
        "properties": { "card": { "type": "integer", "minimum": 0 }, "block": { "type": "string" }, "code": { "type": "string" }, "message": { "type": "string" } }
      }
    },
    "balance": {
      "type": "object", "additionalProperties": false, "required": ["ok"],
      "properties": { "ok": { "type": "boolean" }, "code": { "type": "string" }, "message": { "type": "string" } }
    },
    "reason": { "type": "string" },
    "message": { "type": "string" }
  }
}
