{
  "name": "workspace",
  "version": "1.0.0",
  "description": "Header folder consists of 8 variations of Page Header with Titles",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:drift": "node scripts/check-api-drift.mjs && node --test cloudflare-worker/test/api_drift.test.mjs && node scripts/check-advisor-bank-drift.mjs && node scripts/check-statemachine-coverage.mjs && node --experimental-strip-types --no-warnings --test cloudflare-worker/test/advisor.scenarios.test.ts",
    "test:e2e": "playwright test",
    "build": "cd frontend && npm run build",
    "deploy": "wrangler deploy --env production",
    "deploy:preview": "wrangler deploy --env preview",
    "tail": "wrangler tail",
    "tail:preview": "wrangler tail --env preview",
    "d1:migrate": "wrangler d1 execute studioos-db --remote --file=cloudflare-worker/sql/schema.sql"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@replit/connectors-sdk": "^0.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "fuse.js": "^7.3.0",
    "lucide-react": "^1.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.0",
    "react-window": "^2.2.7",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "wrangler": "~4.90.0"
  }
}
