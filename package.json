{
  "name": "workspace",
  "version": "1.0.0",
  "description": "Header folder consists of 8 variations of Page Header with Titles",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:frontend": "node --import ./frontend/test/_deck-loader.mjs --test 'frontend/test/*.test.mjs'",
    "test:worker": "node --experimental-strip-types --no-warnings --import ./cloudflare-worker/test/_ts-loader.mjs --test 'cloudflare-worker/test/*.test.ts' 'cloudflare-worker/test/*.test.mjs'",
    "test:decks": "node --import ./frontend/test/_deck-loader.mjs --test frontend/test/spinout_demoday_deck.test.mjs frontend/test/deck_templates_missing_data.test.mjs frontend/test/spinout_pptx_build.test.mjs frontend/test/deck_readiness.test.mjs frontend/test/spinout_preview_sync.test.mjs frontend/test/brand_templates.test.mjs",
    "test:guards": "node scripts/check-api-drift.mjs && node scripts/check-sql-unsafe.mjs && node scripts/check-tail-consumer.mjs && node scripts/check-advisor-bank-drift.mjs && node scripts/check-statemachine-coverage.mjs && node scripts/check-deck-templates.mjs && node scripts/check-deck-payload-wiring.mjs && node scripts/check-docs-fresh.mjs",
    "test:types": "cd cloudflare-worker && npx --no-install tsc --noEmit",
    "test:retention": "node --test scripts/lib/assetRetention.test.mjs",
    "test:drift": "npm run test:frontend && npm run test:worker && npm run test:retention && npm run test:guards && npm run test:types && node scripts/check-dark-mode.mjs",
    "test:e2e": "playwright test",
    "build": "node scripts/build-frontend.mjs",
    "predeploy": "node scripts/migrate-d1.mjs --remote",
    "deploy": "npm run build && cd cloudflare-worker && npx wrangler deploy --config ../wrangler.toml --env production",
    "postdeploy": "node scripts/check-spa-live.mjs",
    "verify:live": "node scripts/check-spa-live.mjs",
    "deploy:preview": "cd cloudflare-worker && npx wrangler deploy --config ../wrangler.toml --env preview",
    "tail": "cd cloudflare-worker && npx wrangler tail --config ../wrangler.toml",
    "tail:preview": "cd cloudflare-worker && npx wrangler tail --config ../wrangler.toml --env preview",
    "d1:migrate": "cd cloudflare-worker && npx wrangler d1 execute studioos-db --config ../wrangler.toml --remote --file=sql/schema.sql",
    "d1:migrate:remote": "node scripts/migrate-d1.mjs --remote",
    "d1:migrate:local": "node scripts/migrate-d1.mjs --local",
    "d1:migrate:preview": "node scripts/migrate-d1.mjs --preview",
    "d1:baseline": "node scripts/migrate-d1.mjs --remote --baseline",
    "d1:audit": "node scripts/migrate-d1.mjs --audit",
    "claude:check": "bash scripts/check-anthropic-key.sh",
    "lfs:check": "node scripts/lfs-size-gate.mjs",
    "lfs:check-all": "node scripts/lfs-size-gate.mjs --all",
    "lfs:install-hook": "node scripts/lfs-size-gate.mjs --install"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@replit/connectors-sdk": "^0.4.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.24.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "react-window": "^2.3.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.0",
    "vite": "^8.1.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "wrangler": "^4.118.0"
  }
}
