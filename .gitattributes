# =============================================================================
# Axal StudioOS — Git LFS tracking
# =============================================================================
# Strategy (see MIGRATION_LFS_AUDIT.md):
#   - LFS: versioned source artifacts that belong with the codebase
#     (design sources, ML weights, fixture archives, deck-template PSDs).
#   - R2:  runtime-served traffic (uploads, signed contracts, deck exports,
#          backups, KYC docs). NOT in this file.
#   - GH Releases: public point-in-time artifacts (sector reports, public DD
#                  summaries, quarterly Investor Signals PDFs).
#   - Worker bundle: tiny atomic assets (favicons, OG fallback, regexes).
#
# History is NOT rewritten — these rules apply to NEW and RE-ADDED files only.
# Existing in-tree blobs stay where they are until they are rotated.

# ---- Design sources ----------------------------------------------------------
*.psd     filter=lfs diff=lfs merge=lfs -text
*.psb     filter=lfs diff=lfs merge=lfs -text
*.ai      filter=lfs diff=lfs merge=lfs -text
*.xd      filter=lfs diff=lfs merge=lfs -text
*.fig     filter=lfs diff=lfs merge=lfs -text
*.sketch  filter=lfs diff=lfs merge=lfs -text

# ---- ML weights / model artifacts -------------------------------------------
*.onnx        filter=lfs diff=lfs merge=lfs -text
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.pt          filter=lfs diff=lfs merge=lfs -text
*.pth         filter=lfs diff=lfs merge=lfs -text
*.gguf        filter=lfs diff=lfs merge=lfs -text

# ---- Tabular fixtures / data snapshots --------------------------------------
*.parquet filter=lfs diff=lfs merge=lfs -text

# ---- Archives (sample fixtures, audit snapshots) ----------------------------
*.zip     filter=lfs diff=lfs merge=lfs -text
*.tar.gz  filter=lfs diff=lfs merge=lfs -text
*.tgz     filter=lfs diff=lfs merge=lfs -text

# ---- Video (demo reels, marketing source clips) -----------------------------
*.mp4     filter=lfs diff=lfs merge=lfs -text
*.webm    filter=lfs diff=lfs merge=lfs -text
*.mov     filter=lfs diff=lfs merge=lfs -text

# ---- Audio masters (podcast / sound design) ---------------------------------
*.wav     filter=lfs diff=lfs merge=lfs -text
*.flac    filter=lfs diff=lfs merge=lfs -text

# ---- PDFs / raster images ---------------------------------------------------
# Size-gated by scripts/lfs-size-gate.mjs (rejects > 500 KB without LFS).
# Not auto-tracked here because small inline diagrams + the existing in-tree
# screenshots under attached_assets/ would otherwise rewrite history.
# New > 500 KB PDFs / PNGs MUST be added with `git lfs track` first.

# ---- Line endings ----------------------------------------------------------
* text=auto eol=lf
*.sh text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
