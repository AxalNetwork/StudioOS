# =============================================================================
# Axal StudioOS – Environment Variable Template
# =============================================================================
# Copy this file to `.env` for local development of the FastAPI backend, and
# set the Cloudflare Worker secrets via `wrangler secret put <NAME>`.
#
# DO NOT commit `.env`. Only `.env.example` should live in git.
# =============================================================================

# -----------------------------------------------------------------------------
# Cloudflare account (used by Wrangler / GitHub Actions, not by app code)
# -----------------------------------------------------------------------------
# Get from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Auth / sessions
# -----------------------------------------------------------------------------
# 64+ random chars. Used to sign JWTs issued by the Worker.
#   openssl rand -hex 48
JWT_SECRET=

# Dedicated HMAC key for Epic 5 score-integrity signing.
# REQUIRED in production (ENVIRONMENT=production) — the worker refuses to
# boot without it (T9). Generate and provision with:
#   openssl rand -hex 32
#   npx wrangler secret put SCORING_HMAC_SECRET --env=production
# In dev/preview it MAY be omitted, in which case the worker falls back to
# JWT_SECRET and logs a one-shot startup warning. The dev fallback exists
# so local iteration only needs one secret; production gets a dedicated key
# so a JWT_SECRET leak cannot also forge signed scores.
SCORING_HMAC_SECRET=

# Replit Auth (for the Replit-hosted FastAPI dev backend only)
REPLIT_AUTH_SECRET=

# -----------------------------------------------------------------------------
# Database (Replit dev backend)
# -----------------------------------------------------------------------------
# Auto-provisioned by Replit. The Worker uses Cloudflare D1 instead (configured
# in wrangler.toml as the `DB` binding).
DATABASE_URL=

# -----------------------------------------------------------------------------
# Email (Gmail OAuth via Workers)
# -----------------------------------------------------------------------------
# Create OAuth client at https://console.cloud.google.com/apis/credentials
# Then run scripts/get-gmail-refresh-token.sh (see cloudflare-worker/EMAIL-SETUP.md).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# -----------------------------------------------------------------------------
# Calendar OAuth — Google Calendar + Microsoft 365 / Outlook (T10)
# -----------------------------------------------------------------------------
# Google Calendar push-sync. Create OAuth client at
# https://console.cloud.google.com/apis/credentials with scopes:
#   - https://www.googleapis.com/auth/calendar.events
#   - https://www.googleapis.com/auth/userinfo.email + openid
# The redirect URI must match GOOGLE_CALENDAR_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=https://axal.vc/api/calendar/google/callback

# Microsoft 365 / Outlook push-sync. Register at
# https://portal.azure.com → Azure AD → App registrations.
# Required Graph delegated permissions:
#   Calendars.ReadWrite, User.Read, openid, profile, email, offline_access
# MICROSOFT_TENANT_ID defaults to "common" (work + school + personal).
# Set to a tenant GUID to restrict to a single Azure AD tenant.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALENDAR_REDIRECT_URI=https://axal.vc/api/calendar/microsoft/callback

# -----------------------------------------------------------------------------
# Payments / banking (Stripe Atlas for spin-out incorporation)
# -----------------------------------------------------------------------------
# https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY     — Stripe Billing (mi-pro tier) — used by routes/billing.ts.
# STRIPE_WEBHOOK_SECRET — verifies Stripe webhook signatures (whsec_*).
# STRIPE_ATLAS_API_KEY  — Stripe Atlas API key for spin-out incorporation.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ATLAS_API_KEY=

# -----------------------------------------------------------------------------
# KYC / compliance providers
# -----------------------------------------------------------------------------
# Sumsub: https://cockpit.sumsub.com/checkus#/devSpace/appTokens
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# AI providers (Worker uses Workers AI by default; OpenAI is optional fallback)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Default Workers AI model used for partner/deal scoring
AI_DEFAULT_MODEL=@cf/meta/llama-3.1-8b-instruct
AI_EMBEDDING_MODEL=@cf/baai/bge-base-en-v1.5

# -----------------------------------------------------------------------------
# Bot / abuse protection
# -----------------------------------------------------------------------------
# https://dash.cloudflare.com → Turnstile → Add site
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=

# -----------------------------------------------------------------------------
# GitHub integration (issue sync, activity feed)
# -----------------------------------------------------------------------------
# Fine-grained PAT with `Issues: Read & write` on the StudioOS repo.
GITHUB_ACCESS_TOKEN=
GITHUB_REPO_OWNER=AxalNetwork
GITHUB_REPO_NAME=StudioOS

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30

# -----------------------------------------------------------------------------
# Cloudflare bindings (informational – actual values live in wrangler.toml)
# -----------------------------------------------------------------------------
D1_DATABASE_NAME=studioos-db
QUEUE_NAME=studioos-queue
KV_TOKENS_NAMESPACE=TOKENS
KV_RATE_LIMITS_NAMESPACE=RATE_LIMITS

# -----------------------------------------------------------------------------
# Optional: deploy notifications
# -----------------------------------------------------------------------------
SLACK_DEPLOY_WEBHOOK_URL=
