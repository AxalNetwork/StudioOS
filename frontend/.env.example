# =============================================================================
# Axal StudioOS – Frontend Environment Template
# =============================================================================
# Copy to `frontend/.env.local` for local dev. Vite injects only variables
# prefixed with `VITE_` into the client bundle. NEVER put secrets here —
# anything in this file is shipped to every browser that loads the app.
# =============================================================================

# Backend API base URL. In production the SPA and Worker are same-origin
# under https://app.axal.vc, so the frontend uses the relative `/api`
# base (see frontend/src/lib/api.js) and this var is unused. Override
# only for non-standard deploys (e.g. pointing a localhost SPA at a
# remote preview worker). NEVER set this to a workers.dev URL in any
# environment that hits production OAuth providers — provider apps
# only accept `app.axal.vc` callbacks in prod.
VITE_API_URL=https://app.axal.vc

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (bot protection)
# -----------------------------------------------------------------------------
# PUBLIC site key — safe to expose. Get from:
#   https://dash.cloudflare.com → Turnstile → your widget → "Site Key"
# Leave blank to disable the widget; backend verifier also fails-open when its
# matching secret is unset.
VITE_TURNSTILE_SITE_KEY=
