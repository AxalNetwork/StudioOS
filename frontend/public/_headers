# Response headers for the static frontend, read by Cloudflare Workers static
# assets (the `[assets]` binding in wrangler.toml). Vite copies this file from
# frontend/public/ into docs/, the Worker's assets directory; Workers parses it
# at upload and applies the rules to the responses the assets binding serves —
# the SPA shell on every path outside `run_worker_first` (`/login`,
# `/dashboard`, the single-page-application fallback for every deep link).
# The file itself is never served.
#
# Restored 2026-09-03 (documentation/architecture/DECISIONS.md D36) from the
# copy #371 deleted on 2026-08-31, when a Pages Advanced Mode `_worker.js`
# beside it made it inert. That script, and the Cloudflare Pages mirror it ran
# on, are retired; this file is the only thing setting headers on the shell.
#
# NOT applied to responses the Worker script generates — the
# `run_worker_first` paths `/api/*`, `/landing/*`, `/p/*` and `/assets/*`.
# The first three get cloudflare-worker/src/middleware/securityHeaders.ts;
# `/assets/*` is answered by cloudflare-worker/src/index.ts straight from the
# assets binding, which is why there is no `/assets/*` Cache-Control rule
# here — it would be inert.
#
# Values are the Worker middleware's own (securityHeaders.ts).
# frontend/test/apex_truth_doc.test.mjs fails if the two drift apart, and
# scripts/check-spa-live.mjs asserts these headers on every live shell route
# after a deploy — GOTCHAS records this surface losing its headers twice while
# documents said it had them.
#
# Referrer-Policy is deliberately the laxer value here. The Worker's
# authenticated API surface uses `no-referrer` (NICE-SEC-01) because its URLs
# carry ids and query params; these static pages carry neither and benefit
# from cross-origin referral attribution. The split is intentional — see
# GOTCHAS, "Referrer-Policy is two-tier". Do not unify them.
# Permissions-Policy allows the microphone to this origin only, `(self)`: the
# interview recorder (D685, lib/interviewCapture.js) and the advisor's voice
# input call getUserMedia, and `microphone=()` refused them in every
# Chromium browser (#1587). The camera likewise, `(self)`: the event check-in
# scanner (components/events/CheckinScanner.jsx) reads QR codes from it, and
# `camera=()` sent every organiser to manual entry. No other origin, no frame,
# gets either.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(self), microphone=(self), payment=(), usb=(), bluetooth=(), accelerometer=(), gyroscope=(), magnetometer=(), midi=(), serial=(), hid=(), interest-cohort=()

# D4582: the sign-in page is not indexed. The same directive is in the page's own head (ogRegistry.js, `robots`);
# this header is the copy a crawler reads without parsing HTML, and `scripts/check-spa-live.mjs` asserts it.
/login
  X-Robots-Tag: noindex, follow

# #4565: the proposed v2 legal texts are for counsel's review, not for search (frontend/src/routes/legalDrafts.jsx).
/terms/v2-draft
  X-Robots-Tag: noindex, nofollow
/privacy/v2-draft
  X-Robots-Tag: noindex, nofollow

# D9166 (#9166) revises the note that stood here (D36): the shell now carries a
# Content-Security-Policy, built from hashes rather than the Worker's per-request
# nonce. Every executable inline <script> in index.html (theme init, the dev
# flag, the dev service-worker killer, the boot watchdog) and its one inline
# event handler (the font stylesheet's onload, behind 'unsafe-hashes') is allowed
# by its sha256; the JSON-LD block is data and needs none. 'unsafe-inline' and
# 'unsafe-eval' are not in script-src. The origins are the third parties the SPA
# loads (Stripe, Turnstile, Google sign-in, the Picker and reCAPTCHA, Meta's
# SDK, the video hosts); D9166 names the file behind each one.
#
# REPORT-ONLY FOR NOW. A wrong policy on the shell is a white screen for every
# visitor, so it ships as Content-Security-Policy-Report-Only and is read on a
# PR preview and in production consoles (anything Cloudflare injects, such as
# an analytics beacon, shows up there) before the follow-up renames it to the
# enforcing header.
#
# THE LINE IS GENERATED AND CHECKED. The Vite plugin in frontend/vite.config.js
# (scripts/lib/spaCsp.mjs) hashes the built docs/index.html and writes the line
# into docs/_headers; the build fails when this committed copy is stale, and
# names the line to commit (SPA_CSP_WRITE=1 writes it). It is committed because
# the PR preview copies this file as-is, and the Worker's record cards send the
# same value (socialCards.ts SHELL_HEADERS, pinned to this file by
# social_cards_d1439.test.ts). frontend/test/spa_csp_9166.test.mjs fails if any
# shell in docs/ has inline code without its hash here, and
# scripts/check-spa-live.mjs checks the live header against the live shell.
/*
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'sha256-dBGj+e/NaqsfFw4c8qA301HtqGJSSCd8v/S3nhmD2pc=' 'sha256-/PTziFTk6Dt/0Fcgs6yNpF4ys5xIJeohGtBpNJF7d9Y=' 'sha256-+pU4C5szN74PxrhEyWpPn1Apyx2qt+UWn8MBdhJmvNo=' 'sha256-DdjksPuk5lQ2eFx0WeQMDJvIaEXcvO609doQlj1FcOU=' 'unsafe-hashes' 'sha256-MhtPZXr7+LpJUY5qtMutB+qWfQtMaPccfe7QXtCcEYc=' https://js.stripe.com https://challenges.cloudflare.com https://accounts.google.com https://apis.google.com https://www.google.com https://www.gstatic.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://axal.vc https://app.axal.vc https://www.axal.vc wss://axal.vc wss://app.axal.vc https://api.stripe.com https://*.cloudflareaccess.com https://accounts.google.com https://www.facebook.com; frame-src 'self' blob: https://js.stripe.com https://hooks.stripe.com https://*.stripe.network https://challenges.cloudflare.com https://accounts.google.com https://docs.google.com https://www.google.com https://www.facebook.com https://calendly.com https://www.youtube-nocookie.com https://player.vimeo.com https://iframe.videodelivery.net https://*.cloudflarestream.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# The two standalone pages are not the SPA shell: verify-email.html loads its
# own CDN script and inline code, and offline.html is the service worker's
# fallback. The shell's policy is detached from them (rules apply in file
# order, so these come after the /* rule above); a policy of their own is a
# separate change.
/verify-email
  ! Content-Security-Policy-Report-Only
/verify-email.html
  ! Content-Security-Policy-Report-Only
/offline
  ! Content-Security-Policy-Report-Only
/offline.html
  ! Content-Security-Policy-Report-Only
