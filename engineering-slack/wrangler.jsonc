{
  "$schema": "../cloudflare-worker/node_modules/wrangler/config-schema.json",
  "name": "studioos-engineering-slack",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OUTBOX",
        "class_name": "DeliveryActor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "DeliveryActor"
      ]
    }
  ],
  "services": [
    { "binding": "ENGINEERING_EVENTS", "service": "studioos-engineering-events", "entrypoint": "EngineeringEvents" }
  ],
  "vars": {
    "WORKFLOW_LOGS_ENABLED": "false",
    "DELIVERY_ENABLED": "false",
    "ROUTING_REGISTRY": "null"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
