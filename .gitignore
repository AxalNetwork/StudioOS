# =============================================================================
# Axal StudioOS – .gitignore
# =============================================================================

# ---- Environment / secrets ----
.env
.env.*
!.env.example
!frontend/.env.production
*.pem
*.key

# ---- Node / frontend ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/

# Vite / build output (frontend builds to docs/ which IS committed
# because GitHub Pages serves from there; uncomment if you change that).
# docs/
.vite/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
.venv/
venv/
.pythonlibs/

# ---- Cloudflare / Wrangler ----
.wrangler/
.dev.vars
worker-configuration.d.ts

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Replit local state ----
.cache/
.config/
.upm/
.local/
.agents/

# ---- Logs / tmp ----
*.log
/tmp/
.tmp/

# ---- Cloudflare Worker build output ----
# Regenerated by `npm run build`; never commit the bundle (incl. index.js.map).
dist-deploy/

# ---- Dev-only SQLite (real data lives in D1; never deployed) ----
backend/app.db
backend/*.db
backend/*.sqlite
backend/*.sqlite3
# Catch-all: a dev DATABASE_URL pointed anywhere else in the tree (repo root,
# frontend/) during local reproduction shouldn't leave untracked cruft either.
/*.db
/*.sqlite
/*.sqlite3
frontend/*.db
frontend/*.sqlite
frontend/*.sqlite3

# ---- Per-user activity exports (contain PII; regenerable by the backend) ----
users/*/activity.md
