# =============================================================================
# Axal StudioOS – .gitignore
# =============================================================================

# ---- Environment / secrets ----
.env
.env.*
!.env.example
!frontend/.env.production
*.pem
*.key

# ---- Node / frontend ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/

# Vite / build output (frontend builds to docs/ which IS committed
# because GitHub Pages serves from there; uncomment if you change that).
# docs/
.vite/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
.venv/
venv/
.pythonlibs/

# Dev-only SQLite (real users live in D1 per CLAUDE.md).
backend/app.db
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# Per-user activity exports — generated artifact, contains PII.
users/*/activity.md

# ---- Cloudflare / Wrangler ----
.wrangler/
.dev.vars
worker-configuration.d.ts

# Cloudflare worker bundle output (regenerated by `npm run build`).
# See MIGRATION_LFS_AUDIT.md 2026-06-06 follow-up.
dist-deploy/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Replit local state ----
.cache/
.config/
.upm/
.local/
.agents/

# ---- Logs / tmp ----
*.log
/tmp/
.tmp/
