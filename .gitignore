# =============================================================================
# Axal StudioOS – .gitignore
# =============================================================================

# ---- Environment / secrets ----
.env
.env.*
!.env.example
!frontend/.env.production
*.pem
*.key

# ---- Claude Code agent harness ----
# Isolated git worktrees for background subagents (Agent tool, isolation:
# "worktree"). Tool-managed and ephemeral; never commit these, and never
# touch them while an agent may still be using one.
.claude/worktrees/

# ---- Node / frontend ----
# No trailing slash: a worktree's node_modules can be a symlink, and `node_modules/`
# ignores a directory only (e5956580f committed such a link).
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/
.yarn/

# The route map as one document (D4102, #4102): built from the fragments in
# documentation/architecture/route-map/ by `node scripts/build-route-map.mjs`.
# Nothing reads it back; every script and test reads the fragments.
documentation/architecture/route-map/ROUTE_MAP.combined.md

# The R2 inventory (D6650, #6650): every R2 mutator call site and its class,
# written by `node scripts/build-r2-inventory.mjs --write` from the Worker
# source and the reviewed policy in documentation/operations/R2_INVENTORY.json.
# Generated, so never committed (D5612): `--check` fails if it is tracked.
documentation/operations/R2_INVENTORY.md

# Vite / build output. `docs/` is NOT committed (D529): the Cloudflare Worker
# serves it from its `[assets]` binding on both axal.vc and app.axal.vc, and
# every job that needs it builds it from `frontend/` first — the deploy, the PR
# preview, branch provisioning and the CI jobs that read it (CLAUDE.md fact 4).
# Run the root `npm run build` to produce it locally. The static security
# headers come from `frontend/public/_headers`, built to `docs/_headers`.
#
# The old-bundle window no longer rides on a committed tree either: the
# production deploy restores the last deploy's `docs/assets` and retention
# ledger (`docs/.asset-retention.json`) from an `actions/cache` entry before it
# builds, and saves them after it ships (`cloudflare-worker-deploy.yml`, D529).
/docs/
.vite/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
.venv/
venv/
.pythonlibs/

# ---- Cloudflare / Wrangler ----
.wrangler/
.dev.vars
worker-configuration.d.ts

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- Replit local state ----
.cache/
.config/
.upm/
.local/
.agents/

# ---- Logs / tmp ----
*.log
/tmp/
.tmp/

# ---- Cloudflare Worker build output ----
# Regenerated by `npm run build`; never commit the bundle (incl. index.js.map).
dist-deploy/

# ---- Generated branch Worker configs ----
# `scripts/gen-branch-wrangler.mjs <code>` renders these from
# infra/branches/<code>.json and wrangler.toml's [env.production] table, at the
# repo root because `[assets] directory` resolves against the config's own
# location. Committing one would give a binding a second place to go stale,
# which is the thing deriving it prevents; check-branch-config.mjs fails the
# build if one is ever tracked.
wrangler.branch.*.toml

# ---- Dev-only SQLite (real data lives in D1; never deployed) ----
backend/app.db
backend/*.db
backend/*.sqlite
backend/*.sqlite3
# Catch-all: a dev DATABASE_URL pointed anywhere else in the tree (repo root,
# frontend/) during local reproduction shouldn't leave untracked cruft either.
/*.db
/*.sqlite
/*.sqlite3
frontend/*.db
frontend/*.sqlite
frontend/*.sqlite3

# ---- Per-user activity exports (contain PII; regenerable by the backend) ----
users/*/activity.md

# D1511 (#3762): Playwright results and traces from the visual suite; only CI-made baselines are committed.
frontend/test-results/
frontend/playwright-report/

# D4103 (#4103): the route map's two projections are build output. Every
# routing change rewrote them and parallel branches conflicted on them. CI
# builds them and keeps them as the `routing-docs` artifact of its
# `routing docs (artifact)` job; `npm run docs:routing` writes them here. `node
# scripts/build-profile-routing.mjs --check` fails if either is committed again.
documentation/architecture/PROFILE_ROUTING.md
documentation/architecture/PAGE_INVENTORY.md

# #4570: the authorization inventory is build output. `node scripts/build-auth-inventory.mjs`
# writes it; CI keeps it in the `routing-docs` artifact; `--check` in test:guards checks the ledger.
documentation/architecture/AUTH_INVENTORY.json
documentation/architecture/STRIPE_IDEMPOTENCY_INVENTORY.json

# D8526: the company-scope inventory is build output; `--check` in test:guards checks its ledger.
documentation/architecture/COMPANY_SCOPE_INVENTORY.json

# D5612 (#5612): three generated modules are build output, never committed.
# `node scripts/build-generated.mjs` writes them; every build, typecheck and
# test runs it first. Each generator's `--check` fails if one is tracked again.
cloudflare-worker/src/routes/_registry.ts
frontend/src/lib/apiModules.generated.js
cloudflare-worker/src/services/agents/skillLibrary.generated.ts
# D8519 (#8519): the model inventory is build output too; `node scripts/build-model-inventory.mjs` writes it, `--check` gates it.
documentation/architecture/MODEL_INVENTORY.json
# D4574 H3 (#4574): the skill library's entries, the static asset the same generator writes beside it.
frontend/public/skill-library/

# #4591: written by scripts/schema-rehearsal.mjs for its throwaway databases, deleted when it ends.
wrangler.rehearsal.*.toml
agent-compute/worker-configuration.d.ts
agent-compute/__pycache__/
# D4594 part 3: hosted Stage A's throwaway Worker config, written and deleted by scripts/agent-stage-a.mjs.
wrangler.s4594.*.toml
# D4870 part 2: the gateway live check's throwaway Worker config, written and deleted by scripts/gateway-live-check.mjs.
wrangler.s4870.*.toml

# D5682 (#5682): the section reporting route coverage table is build output.
# `node scripts/build-section-coverage.mjs --write` writes it; `--check` fails if it is committed again.
documentation/architecture/SECTION_COVERAGE.md

# D7741 (#7741): private research payloads never enter git. A pushed branch of
# this repository is public, so these rules are the prevention; the check in
# cloudflare-worker/test/private_payload_guard_7741.test.mjs reads the lines
# below and fails on a tracked match, which is an incident (D7741), not a fix.
# The exact names of the two delivered files (the import-package JSON and the
# four-source capture archive) are not recorded anywhere; these lines cover
# their described shape until the owner confirms them.
*.private.*
private-payloads/
*import-package*.json
*import_package*.json
*four-source*
*four_source*
*4-source*
*4_source*
*capture*.zip
*capture*.tar
*capture*.tar.gz
*capture*.tgz
*capture*.7z

# D5505: local guard and preflight diagnostics, regenerated for each invocation.
/guard-results.json
/preflight-results.json
wrangler.agent-compute.approved.json
